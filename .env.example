# Public environment label shown by /version.
APP_ENV=development

# Optional deployment metadata. Render provides RENDER_GIT_COMMIT automatically.
COMMIT_SHA=unknown
DEPLOYED_AT=unknown

# Public PayPal SDK client identifier. This is not a secret.
PAYPAL_CLIENT_ID=

# Per-web-process safety limits for public requests.
MAX_REQUEST_BYTES=3000000
HEAVY_REQUESTS_PER_MINUTE=8
